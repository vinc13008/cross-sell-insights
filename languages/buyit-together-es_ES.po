msgid_plural "%d products restored to their previous cross-sells."
msgstr[0] "%d producto restaurado a sus ventas cruzadas anteriores."
msgstr[1] "%d productos restaurados a sus ventas cruzadas anteriores."

#: buyit-together.php:1270
msgid "Nothing to undo."
msgstr "Nada que deshacer."

#: buyit-together.php:1275
msgid "Calculation refreshed — see the numbers below."
msgstr "Cálculo actualizado — consulta las cifras a continuación."

#: buyit-together.php:1292
msgid "This site still stores its orders the classic way. BuyIt Together reads the newer high-performance order tables, which are empty here — so the analysis below finds no orders and no associations, however many sales you have. Switching WooCommerce to high-performance order storage (WooCommerce → Settings → Advanced → Features) makes the numbers real."
msgstr "Este sitio sigue guardando sus pedidos a la manera clásica. BuyIt Together lee las nuevas tablas de pedidos de alto rendimiento, que aquí están vacías: por eso el análisis de abajo no encuentra ningún pedido ni ninguna asociación, por muchas ventas que tengas. Cambiar WooCommerce al almacenamiento de pedidos de alto rendimiento (WooCommerce → Ajustes → Avanzado → Características) hace que las cifras sean reales."

#: buyit-together.php:1428
msgid "No cross-sells configured"
msgstr "Sin ventas cruzadas configuradas"

#: buyit-together.php:1431
msgid "Configuration unrelated to your sales"
msgstr "Configuración sin relación con tus ventas"

#: buyit-together.php:1434
msgid "Weak match"
msgstr "Coincidencia débil"

#: buyit-together.php:1437
msgid "Partial match"
msgstr "Coincidencia parcial"

#: buyit-together.php:1440
msgid "Configuration matches your sales"
msgstr "La configuración coincide con tus ventas"

#: buyit-together.php:1444
msgid "What your sales say. Nothing to configure here: the suggested corrections can be applied, but configuration happens in the other tabs."
msgstr "Lo que dicen tus ventas. Aquí no hay nada que configurar: puedes aplicar las correcciones sugeridas, pero la configuración se hace en las demás pestañas."

#: buyit-together.php:1450
msgid "of your cross-sells match a real purchase"
msgstr "de tus ventas cruzadas corresponden a una compra real"

#. translators: 1: confirmed associations, 2: configured cross-sells, 3: orders analysed
#: buyit-together.php:1469
#, php-format
msgid "%1$d associations confirmed out of %2$d configured, measured across %3$d orders from the last 12 months."
msgstr "%1$d asociaciones confirmadas de %2$d configuradas, medidas sobre %3$d pedidos de los últimos 12 meses."

#: buyit-together.php:1475
msgid "Run the analysis again"
msgstr "Volver a ejecutar el análisis"

#. translators: %d: number of products excluded from suggestions
#: buyit-together.php:1509
#, php-format
